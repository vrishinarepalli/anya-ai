# Supabase — from your project dashboard at supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# These are NOT stored here. Users connect their own provider keys
# through the Settings → API Keys UI. Keys are encrypted in Supabase Vault.
# The server reads them at request time only — they never reach the frontend.
